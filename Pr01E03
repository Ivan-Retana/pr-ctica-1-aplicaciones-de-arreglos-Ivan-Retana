#include <stdio.h>

int main() {
    int mat[2][3] = {{1, 2, 3}, {4, 5, 6}};
    
    for (int i = 0; i < 2; i++) { 
        for (int j = 0; j < 3; j++) {
            printf("mat[%d][%d]: %p\n", i, j, (void*)&mat[i][j]);
        }
    }
    
    printf("Direccion de mat[0][2]: %p\n", (void*)&mat[0][2]);
    printf("Direccion de mat[1][0]: %p\n", (void*)&mat[1][0]);

    
    return 0;
}
